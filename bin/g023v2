#!/usr/bin/env python3
"""System-wide entry for the g023v2 DeepSeek Flash harness."""

from __future__ import annotations

import sys
from pathlib import Path

# Resolve through this file even when invoked via a symlink on PATH.
ROOT = Path(__file__).resolve().parent.parent
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from g023v2.cli import main  # noqa: E402

if __name__ == "__main__":
    main()
